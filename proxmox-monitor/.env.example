# ===== Telegram =====
TELEGRAM_BOT_TOKEN=123456789:dein-bot-token
# Chats, die Alarme erhalten und den Bot bedienen dürfen (kommagetrennt)
TELEGRAM_CHAT_IDS=111111111

# ===== Proxmox-API (API-Token, nicht das root-Passwort) =====
PROXMOX_HOST=127.0.0.1
PROXMOX_USER=monitor@pve
PROXMOX_TOKEN_NAME=guardian
PROXMOX_TOKEN_VALUE=
PROXMOX_NODE=pve

# ===== Allgemein =====
HOST_LABEL=Proxmox
CHECK_INTERVAL_SECONDS=60
ROUTER_IP=192.168.1.1
# Ping-Ziele für die Netzwerkansicht
PING_TARGETS=1.1.1.1,8.8.8.8,api.telegram.org,192.168.1.1
# Port-Checks im Format Name:Host:Port
PORT_CHECKS=Webserver:192.168.1.20:443
